Map.centerObject(aoi, 8);
var mapstyle = aoi.style({
  color: 'black',
  fillColor: '00000000',
  width: 2,
})
Map.addLayer(mapstyle,{}, 'Kashmir Boundary');

// Cloud masking
function maskClouds (image) {
  var qa = image.select('QA_PIXEL');
  var cloudmask = qa.bitwiseAnd(1<<3).eq(0)
                  .and(qa.bitwiseAnd(1<<5).eq(0));
                  return image.updateMask(cloudmask);
}

// Load the Dataset
var landsat = ee.ImageCollection("LANDSAT/LC08/C02/T1_TOA")
.filterDate('2024-01-01','2024-12-31')
.filterBounds(aoi)
.map(maskClouds)
.select(['B2','B3','B4','B5'])


// mosaic and cip
var mosaic = landsat.median().clip(aoi)

// Visualize the parameters 
var VisiParaFCC = {
  min: 0,
  max: 1,
  bands: ['B5','B4','B3'],
  gamma: 1.5
};

var VisiParaTCC = {
  min: 0,
  max: 1,
  bands:['B4','B3','B2'],
  gamma: 1.3
};

// Display FCC and TCC on map 
Map.addLayer(mosaic, VisiParaFCC, 'FCC');
Map.addLayer(mosaic, VisiParaTCC, 'TCC');

// Export the image
Export.image.toDrive ({
  image: mosaic.visualize(VisiParaTCC),
  description: 'Kashmir TCC',
  folder: 'Nyran Work',
  scale: 30,
  region: aoi.geometry(),
  maxPixels: 1e13,
});
